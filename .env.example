# Local academic prototype only. These deterministic values are placeholders,
# not production credentials. Copy this file to .env before using Compose.

# PostgreSQL 16: the owner is used only by prototype-bootstrap; serving uses app.
POSTGRES_DB=science_faculty
POSTGRES_OWNER_USER=prototype_owner
POSTGRES_OWNER_PASSWORD=local-owner-password
POSTGRES_APP_USER=prototype_app
POSTGRES_APP_PASSWORD=local-app-password
POSTGRES_PORT=5432
APP_DATABASE_URL=postgresql+psycopg://prototype_app:local-app-password@postgres:5432/science_faculty
MIGRATION_DATABASE_URL=postgresql+psycopg://prototype_owner:local-owner-password@postgres:5432/science_faculty
# Compose transport aliases deliberately avoid stale machine-wide database URL
# variables taking precedence over this file. Keep each alias equal to its
# corresponding contract URL above.
COMPOSE_APP_DATABASE_URL=postgresql+psycopg://prototype_app:local-app-password@postgres:5432/science_faculty
COMPOSE_MIGRATION_DATABASE_URL=postgresql+psycopg://prototype_owner:local-owner-password@postgres:5432/science_faculty

# Explicit academic demo mode. SEED_DEMO_DATA=true includes the full demo dataset.
APP_ENV=development
DEMO_MODE=true
SEED_DEMO_DATA=true
JWT_SECRET=local-prototype-jwt-secret-not-for-shared-deployments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_PORT=8000

# Local MinIO and evidence policy.
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=localminio
MINIO_SECRET_KEY=local-minio-password
MINIO_BUCKET=evidence
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
EVIDENCE_ALLOWED_EXTENSIONS=[".pdf"]
EVIDENCE_ALLOWED_MIME_TYPES=["application/pdf"]
EVIDENCE_MAX_BYTES=10485760

# Local n8n service. The backend webhook is disabled while N8N_WEBHOOK_URL is empty.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_PUBLIC_PORT=5678
N8N_WEBHOOK_URL=
INGEST_API_KEY=local-prototype-ingest-key-not-for-shared-deployments

# Dropbox is optional at startup and remains disabled while these values are empty.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

# Import worker limits.
IMPORT_PDF_MAX_CONCURRENCY=3
IMPORT_PDF_MAX_RETRIES=2

# Browser-visible local application configuration.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
